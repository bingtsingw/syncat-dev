{
  "name": "syncat-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check-mono": "sherif",
    "check-publish": "pnpm run build && pnpm run check && pnpm run test",
    "changeset-publish": "pnpm run check-publish && changeset publish",
    "clean": "del **/dist **/.build **/.swc **/node_modules !node_modules",
    "commit": "czg",
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "prepare": "vp hooks enable",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@types/node": "catalog:",
    "@xstools-dev/cli-toolkit": "catalog:",
    "@xstools-dev/config-ts": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
